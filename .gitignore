# Virtualenv -- 3.8 GB, and it is platform specific anyway
.venv-win/
__pycache__/
*.pyc

# Recorded datasets -- 1.6 GB of video, and they contain footage of the room
datasets/

# Trained checkpoints -- 919 MB, 207 MB each
policies/
# Retired checkpoints, kept on disk in case one is needed again. See the
# 当前状态 section of MODELS.md for what each one is and why it was retired.
policies_archive/

# Run logs, may contain local paths
logs/

# Reference frames grabbed from the cameras
camera_refs/

# Generated analysis images. Regenerate with the scripts in tools/.
# Several of these are photographs of the workspace and of whoever is sitting
# in front of the webcam, so they are deliberately not published.
figures/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# 生态调查下载的模型和数据集（15 GB），README.md 要进版本库
survey/models/
survey/datasets/
survey/repos/

# live-rollout runtime state, rewritten on every run
task.txt
task.status
# Which camera index is top and which is wrist. robot.ps1 re-detects and
# rewrites it on every record or eval, and the indices swap between boots.
camera_map.json
# scratch scripts
tools/_*_tmp.sh
