// =====================================================================
// 顶部相机支架 cam_mount_top（32x32 模组版）—— 扩大中央开口
//
// 和手腕支架 (#18) 同一个问题、同一个解法：官方开口按别的相机开的，
// innomaker U20CAM-1080P 塞不进去。
//
// 实测原件几何（板平面局部坐标系）：
//   板法向     n = (0.423, -0.906, 0)     # 与手腕件是 Y 镜像
//   板面       n·p = -318.75 .. -315.75   -> 板厚 3.0 mm
//   4 个安装孔  (-193.5, ±13.5) (-166.5, ±13.5)  -> 孔距 27.0 x 27.0
//   原开口     15.2 x 26.8，中心 (-179.94, 0.04) = 孔位中心
//   已确认：开口区域法向上只有板本身，立柱不在后面，可放心切穿
//
// 十字开口的道理见 README #18：四角被螺丝孔卡住，上下左右中段有余量。
// =====================================================================

STL = "cam_mount_top.stl";

// ---- 开口参数（和手腕件保持一致，改这里）----
VBAR_W = 19.5;   // 竖条宽 = 最小通过宽度
VBAR_H = 29.0;
HBAR_W = 28.0;
HBAR_H = 19.5;

// ---- 实测常量 ----
CU = -179.94;    // 开口中心 u
CV =    0.04;    // 开口中心 v
CUT_N0 = -321;   // 切削法向范围，要盖住 -318.75..-315.75
CUT_N1 = -313;

// 局部坐标 -> 世界坐标。R = [n; cross(n,zhat); zhat]，正交且对称，故 R^-1 = R。
NX = 0.42305; NY = -0.90611;
M = [[ NX,  NY, 0, 0],
     [ NY, -NX, 0, 0],
     [  0,   0, 1, 0]];

module plate_box(w, h) {
    multmatrix(M)
        translate([(CUT_N0 + CUT_N1) / 2, CU, CV])
            cube([CUT_N1 - CUT_N0, w, h], center = true);
}

difference() {
    import(STL, convexity = 10);
    union() {
        plate_box(VBAR_W, VBAR_H);
        plate_box(HBAR_W, HBAR_H);
    }
}
