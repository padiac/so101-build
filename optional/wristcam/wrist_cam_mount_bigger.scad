// =====================================================================
// SO-ARM101 手腕相机支架 —— 扩大中央开口版
//
// 问题：原件中央开口外接框只有 16 x 25 mm，
//       innomaker U20CAM-1080P 的镜头座/背面元件塞不进去。
//
// 实测原件几何（射线投射切片，板平面局部坐标系）：
//   板法向      n = (0.423, 0.906, 0)   —— 板是斜的，不与任何主轴平行
//   板厚        4.2 mm  (法向距离 -55.42 .. -51.2)
//   4 个安装孔   (-42.10, 4.00) (-42.10, 31.00) (-15.10, 4.00) (-15.10, 31.00)
//               -> 孔距 27.0 x 27.0 mm，孔径约 2.2
//   原开口      外接框 16 x 25，中心 (-28.53, 17.55)，实际面积 310mm2(十字形)
//   板轮廓      u -45.03..-8.63   v 0.20..35.00
//
// 做法：在板平面局部坐标系里挖一个更大的十字，然后变换回世界坐标。
//   十字优于矩形：四角被螺丝孔限制，但上下左右中段还有余量，
//   十字正好利用这些余量，在保证孔周围有筋的前提下把开口做到最大。
//
// 保证的最小筋宽（开口边缘到孔"边缘"）：约 2.7 mm
// =====================================================================

STL = "SO-ARM101_camera_wrist_mount.stl";

// ---- 开口参数（想调就改这四个）----
VBAR_W = 19.5;   // 竖条宽度（决定最小通过宽度）
VBAR_H = 29.0;   // 竖条高度
HBAR_W = 28.0;   // 横条宽度
HBAR_H = 19.5;   // 横条高度

// ---- 实测常量，别动 ----
CU = -28.53;     // 开口中心 u
CV =  17.55;     // 开口中心 v
CUT_N0 = -58;    // 切削在法向上的起止（要穿透 4.2mm 的板）
CUT_N1 = -49;

// 板平面局部坐标系 -> 世界坐标 的变换矩阵。
// 测量时用的是 R = [n; cross(n,zhat); zhat]（行向量），且 R 正交对称，
// 所以 R^-1 = R^T = R，正变换和逆变换是同一个矩阵。
NX = 0.42305; NY = 0.90611;
M = [[ NX,  NY, 0, 0],
     [ NY, -NX, 0, 0],
     [  0,   0, 1, 0]];

// 在局部坐标里定义一个盒子：法向跨 CUT_N0..CUT_N1，面内以 (CU,CV) 为中心
module plate_box(w, h) {
    multmatrix(M)
        translate([(CUT_N0 + CUT_N1) / 2, CU, CV])
            cube([CUT_N1 - CUT_N0, w, h], center = true);
}

difference() {
    import(STL, convexity = 10);
    union() {
        plate_box(VBAR_W, VBAR_H);   // 竖条
        plate_box(HBAR_W, HBAR_H);   // 横条
    }
}
